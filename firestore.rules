rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read and write only their own profile document.
    // The signup flow creates: users/{uid} = {uid, name, email, createdAt}.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Saved delivery addresses (managed from the Profile screen).
      match /addresses/{addressId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }
    }

    // Orders are write-once for customers:
    //  - create: signed-in user, and the document's userId must be their own uid
    //  - read:   only their own orders (query must filter userId == auth.uid)
    //  - update/delete: forbidden for regular users (status changes later
    //    belong to an admin/Cloud Function service account).
    match /orders/{orderId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'Pending';
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    // Restaurants collection: community-submitted food spot listings.
    match /restaurants/{restaurantId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                     && request.resource.data.postedByUid == request.auth.uid;
      allow update, delete: if request.auth != null
                              && resource.data.postedByUid == request.auth.uid;
    }
  }
}
